# Copy to .env for local development:  cp .env.example .env
# docker compose and the Spring Boot backend both read this file.
# Everything runs on mocks by default, so no API keys are needed to try the app.

# --- Database (docker-compose.yml starts this Postgres) ---
POSTGRES_DB=genz_english
POSTGRES_USER=genz
POSTGRES_PASSWORD=change-me-local-only
# 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
DATABASE_URL=jdbc:postgresql://localhost:5433/genz_english
DATABASE_USER=genz
DATABASE_PASSWORD=change-me-local-only

# --- Auth ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# "mock" accepts fake Google tokens so you can test sign-in without a Google Cloud project.
# Use "google" plus GOOGLE_CLIENT_IDS (comma-separated OAuth client IDs) for real Google sign-in.
GOOGLE_AUTH_PROVIDER=mock
GOOGLE_CLIENT_IDS=

# Origins allowed to call the API from a browser (Expo web). Native apps don't need this.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# --- AI providers: "mock" runs fully offline ---
LLM_PROVIDER=mock
STT_PROVIDER=mock
# Luna's voice:
#   elevenlabs  the ElevenLabs voice you pick, for English and Kannada (and every other language). Put your API key
#               (elevenlabs.io > Developers > API keys) and the voice's ID (Voices > your voice > the ID button) below.
#               Every clip is kept in SPEECH_CACHE_DIR, so each sentence is only paid for once.
#   kokoro      a free neural voice that runs on your own machine, English only (Kannada then uses the phone's
#               voice): start it with `docker compose up -d tts` (the first start downloads ~350 MB).
#   mock        the phone's built-in voice.
TTS_PROVIDER=kokoro
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
KOKORO_URL=http://localhost:8090
PRONUNCIATION_PROVIDER=mock

# --- Mobile app (Expo reads EXPO_PUBLIC_* from mobile/.env) ---
# Leave unset to auto-detect: Android emulator -> 10.0.2.2, web/iOS simulator -> localhost,
# physical device on Expo -> your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
